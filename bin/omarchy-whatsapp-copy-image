#!/usr/bin/env bash

# Copy a downloaded WhatsApp image to the Wayland clipboard without putting
# the image bytes or a shell-escaped command in a process argument.
set -euo pipefail

path="${1:-}"
media_dir="${OMARCHY_WHATSAPP_MEDIA:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-whatsapp/media}"

[[ -n $path && -f $path && ! -L $path ]] || exit 1
[[ -d $media_dir ]] || exit 1
[[ $(realpath -- "$(dirname -- "$path")") == "$(realpath -- "$media_dir")" ]] || exit 1

mime="$(file --brief --mime-type -- "$path")"
case "$mime" in
  image/png)
    exec wl-copy --type image/png < "$path"
    ;;
  image/jpeg|image/webp|image/gif)
    # Many desktop apps only accept PNG clipboard images even when they can
    # display JPEG or WebP files. Convert the first frame before copying.
    command -v ffmpeg >/dev/null 2>&1 || {
      echo "omarchy-whatsapp: ffmpeg is required to copy this image" >&2
      exit 1
    }
    ffmpeg -nostdin -hide_banner -loglevel error -i "$path" \
      -map 0:v:0 -frames:v 1 -f image2pipe -c:v png - | wl-copy --type image/png
    ;;
  *) exit 1 ;;
esac
